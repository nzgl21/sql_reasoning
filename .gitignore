# ==========================================
# 1. Виртуальные окружения (UV / venv / conda)
# ==========================================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ==========================================
# 2. Кэш Python и байт-код
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ==========================================
# 3. Данные и базы данных (Heavy Data & DBs)
# ==========================================
data/raw/
data/processed/
data/databases/
data/cache/
*.sqlite
*.sqlite3
*.db

# ==========================================
# 4. Выходы обучения (Чекпоинты, веса, логи)
# ==========================================
outputs/
checkpoints/
runs/
wandb/
*.safetensors
*.bin
*.pt
*.pth

# ==========================================
# 5. Секреты и переменные окружения
# ==========================================
.env
.env.local
.env.*.local
!.env.example

# ==========================================
# 6. IDE, редакторы и операционная система
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# VS Code & PyCharm
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Ноутбуки Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ==========================================
# 7. Сборка пакетов (Build artifacts)
# ==========================================
build/
dist/
*.egg-info/
.eggs/
